# ---------------------------------------------------------------------------
# Hito - configuration. Copy to .env and fill in. EVERY value is optional:
# with an empty .env the app runs in full demo mode (mock PayPal + rule-based
# engine), so a judge can clone and run it with zero accounts.
# ---------------------------------------------------------------------------

# --- PayPal (https://developer.paypal.com/dashboard/applications/sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live   (keep sandbox for the hackathon)
PAYPAL_ENV=sandbox
# The sandbox BUSINESS account that issues the invoices (Laura's account).
PAYPAL_INVOICER_EMAIL=
PAYPAL_INVOICER_GIVEN_NAME=Laura
PAYPAL_INVOICER_SURNAME=Restrepo
PAYPAL_INVOICER_BUSINESS=Laura Restrepo Design Studio
# Webhook id from the sandbox app, needed to verify webhook signatures.
PAYPAL_WEBHOOK_ID=

# ---------------------------------------------------------------------------
# AI engine
#
# Hito's default is an OPEN-SOURCE model running locally through Ollama. No
# account, no API key, no cost, and the contract never leaves the machine -
# which matters, because a contract carries a client's name, address and fee
# schedule.
#
#   1. install Ollama      https://ollama.com/download
#   2. ollama pull qwen2.5:3b
#   3. that is it - Hito finds it and says so in the header
#
# auto   local model first, then the hosted open-weights model if configured,
#        then Claude if a key is set, then the deterministic engine  (default)
# ollama only the local model
# remote only the hosted open-weights model
# claude only Claude
# rules  only the deterministic engine
# ---------------------------------------------------------------------------
HITO_LLM_PROVIDER=auto

# Qwen2.5 3B Instruct, Apache-2.0. Swap in any Ollama model you prefer:
# qwen2.5:7b is noticeably better if you have the RAM, qwen2.5:1.5b is faster
# on a thin laptop.
HITO_OLLAMA_MODEL=qwen2.5:3b
OLLAMA_HOST=http://127.0.0.1:11434
HITO_OLLAMA_CTX=8192
HITO_OLLAMA_TIMEOUT=180

# --- The same open weights, hosted (optional) ------------------------------
# For deployments with no GPU of their own - the Render demo uses this so a
# judge who only clicks the link still sees a model working. Any
# OpenAI-compatible endpoint: OpenRouter, Groq, Together, your own vLLM.
# The Render demo uses a FREE open-weights model because this project has no
# budget for metered inference. Paid options are better - qwen/qwen3-32b is
# Apache-2.0 and costs about $0.0003 per demo run - but they need credit.
HITO_REMOTE_BASE_URL=
HITO_REMOTE_API_KEY=
HITO_REMOTE_MODEL=nvidia/nemotron-3.5-super-vl:free

# --- Claude (optional) ----------------------------------------------------
# Only needed if you want Claude as the engine instead of the local model.
# https://platform.claude.com
ANTHROPIC_API_KEY=
HITO_MODEL=claude-opus-5-5
HITO_MODEL_FAST=claude-haiku-5-5

# --- Policy ---------------------------------------------------------------
# Payout items at or below this amount are sent after one approval click;
# anything above needs Laura to confirm the specific item.
PAYOUT_APPROVAL_THRESHOLD_USD=800
# Force mock PayPal even if credentials exist (useful for recording a demo).
HITO_FORCE_MOCK=0
